---
import Painting from './Painting.astro';
import { paintings } from '../data/paintings';

const doors = [
  {
    href: '/story',
    eyebrow: 'The personal frame',
    title: 'The story',
    text: 'A long read in ten short chapters: a farming family in Mandsaur, a hostel at eleven, Kota, choosing IIT Jammu, five days with a script, and what I am still learning.',
    items: ['Where I come from', 'How I learned to work', 'What I am still getting wrong', 'What comes next'],
    cta: 'Read the story',
    img: 'gateway' as const,
    pos: 'center 62%',
  },
  {
    href: '/resume',
    eyebrow: 'The professional frame',
    title: 'The résumé',
    text: 'The same life in a format you can scan in a minute: education, roles, responsibilities, numbers, projects and skills. Printable, and saves as a PDF.',
    items: ['Education', 'Experience and positions', 'Projects in progress', 'Skills and recognition'],
    cta: 'Open the résumé',
    img: 'column' as const,
    pos: 'center 22%',
  },
];
---
<section class="section" id="frames" aria-labelledby="frames-title">
  <Painting name="sword" dim={0.62} />
  <div class="wrap stack">
    <div class="glass strong head-panel">
      <p class="eyebrow">Two ways in</p>
      <h2 class="h2" id="frames-title">The person, or the professional</h2>
      <p class="lede">Pick how you want to meet me. Both tell the truth; one just takes longer.</p>
    </div>
    <div class="doors">
      {
        doors.map((d) => {
          const p = paintings[d.img];
          return (
            <a class="door glass strong" href={d.href} data-card>
              <picture>
                <source type="image/avif" srcset={`/bg/${p.base}-800.avif 800w, /bg/${p.base}-1200.avif 1200w`} sizes="(max-width: 1040px) 92vw, 560px" />
                <img src={`/bg/${p.base}-800.webp`} srcset={`/bg/${p.base}-800.webp 800w, /bg/${p.base}-1200.webp 1200w`} sizes="(max-width: 1040px) 92vw, 560px" alt="" loading="lazy" style={`object-position:${d.pos}`} />
              </picture>
              <div class="door-body">
                <p class="eyebrow">{d.eyebrow}</p>
                <h3>{d.title}</h3>
                <p class="text">{d.text}</p>
                <ul>{d.items.map((i) => <li>{i}</li>)}</ul>
                <span class="btn btn-ghost go">
                  {d.cta}
                  <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M5 10h10M11 6l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .doors {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }
  .door {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 12px;
    color: #fff;
    text-decoration: none;
    transform: perspective(900px) rotateX(var(--ry, 0deg)) rotateY(var(--rx, 0deg));
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .door img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 14px;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .door picture {
    display: block;
    overflow: hidden;
    border-radius: 14px;
  }
  .door:hover img {
    transform: scale(1.04);
  }
  .door-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 18px 14px;
  }
  h3 {
    font-size: 38px;
  }
  .text {
    color: var(--text-2);
    font-size: 19px;
  }
  ul {
    margin: 4px 0 6px;
    padding-left: 20px;
    color: #eef2fb;
    font-size: 18px;
  }
  li::marker {
    color: var(--red-hi);
  }
  .go {
    align-self: flex-start;
  }
  .door:hover .go {
    background: var(--marble);
    color: var(--navy);
  }
  @media (max-width: 1040px) {
    .doors {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
