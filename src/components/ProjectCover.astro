---
// Typographic cover used until a real project image is added in projects.ts
import type { Project } from '../data/projects';
import { statusLabels } from '../data/projects';
interface Props {
  project: Project;
  index: number;
  large?: boolean;
}
const { project, index, large = false } = Astro.props;
const angle = [90, 72, 108, 84, 96, 66, 114, 78][index % 8];
---
{
  project.image ? (
    <img class:list={['cover-img', { large }]} src={project.image.src} alt={project.image.alt} loading="lazy" />
  ) : (
    <div class:list={['cover', { large }]} style={`--a:${angle}deg`} role="img" aria-label={`${project.title}: ${project.cover.word}, ${project.cover.caption}`}>
      <span class="ghost" aria-hidden="true">{project.cover.letter}</span>
      <span class="figure" aria-hidden="true">{project.cover.word}</span>
      <span class="caption" aria-hidden="true">{project.cover.caption}</span>
      <span class="status" aria-hidden="true">{statusLabels[project.status]}</span>
    </div>
  )
}

<style>
  .cover,
  .cover-img {
    position: relative;
    aspect-ratio: 4 / 3;
    width: 100%;
    border-radius: 14px;
    overflow: hidden;
    object-fit: cover;
  }
  .cover {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 20px 22px;
    background:
      repeating-linear-gradient(var(--a), rgba(237, 229, 220, 0.07) 0 2px, transparent 2px 22px),
      radial-gradient(120% 90% at 85% 10%, rgba(242, 232, 196, 0.22), transparent 55%),
      linear-gradient(160deg, #22539f, #0b2266 60%, #081a52);
    border: 1px solid rgba(255, 255, 255, 0.18);
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .ghost {
    position: absolute;
    right: -4%;
    top: -18%;
    font: 220px/1 var(--display);
    color: rgba(237, 229, 220, 0.1);
    pointer-events: none;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .figure {
    position: relative;
    font: 46px/1.05 var(--display);
    color: var(--marble);
    letter-spacing: 0.02em;
  }
  .caption {
    position: relative;
    font-size: 17px;
    color: var(--text-2);
    font-style: italic;
  }
  .status {
    position: absolute;
    left: 16px;
    top: 14px;
    font: 13px/1 var(--display);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .large .figure {
    font-size: clamp(52px, 7vw, 88px);
  }
  .large .ghost {
    font-size: 380px;
  }
</style>
