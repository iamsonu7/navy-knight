---
// Full-bleed background painting with the blue tint over it.
// Files are produced by `npm run images` from /raw into /public/bg.
import type { Painting } from '../data/projects';

interface Props {
  name: Painting;
  position?: string;
  tint?: number;
  eager?: boolean;
  depth?: boolean; // pointer parallax layer (hero only)
}

const files: Record<Painting, { base: string; widths: number[] }> = {
  sword: { base: 'sword-milkyway', widths: [800, 1125] },
  gateway: { base: 'gateway-sea', widths: [800, 1200] },
  column: { base: 'warrior-column', widths: [800, 1200] },
  temple: { base: 'temple-pool', widths: [800, 1200] },
  moon: { base: 'moon-angel', widths: [800, 1200] },
};

const { name, position = 'center', tint = 0.22, eager = false, depth = false } = Astro.props;
const f = files[name];
const set = (ext: string) => f.widths.map((w) => `/bg/${f.base}-${w}.${ext} ${w}w`).join(', ');
const largest = f.widths[f.widths.length - 1];
---
<div class="painting" aria-hidden="true" data-depth={depth ? '' : undefined}>
  <picture>
    <source type="image/avif" srcset={set('avif')} sizes="100vw" />
    <source type="image/webp" srcset={set('webp')} sizes="100vw" />
    <img
      src={`/bg/${f.base}-${largest}.webp`}
      alt=""
      width={largest}
      height={Math.round(largest * 4 / 3)}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
      style={`object-position:${position}`}
    />
  </picture>
  <div class="tint" style={`background:rgba(6,18,64,${tint})`}></div>
</div>

<style>
  .painting {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .painting picture,
  .painting img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .painting img {
    object-fit: cover;
  }
  .painting[data-depth] img {
    inset: -24px;
    width: calc(100% + 48px);
    height: calc(100% + 48px);
    max-width: none;
    transform: translate3d(var(--px, 0), var(--py, 0), 0);
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    will-change: transform;
  }
  .tint {
    position: absolute;
    inset: 0;
  }
</style>
