---
import Painting from './Painting.astro';
import { site, focus, principles } from '../data/site';
import { paintings } from '../data/paintings';

// Named stars, placed on the painting's sky (percentages of the image). Order = constellation order.
const stars = [
  { x: 16, y: 34 },
  { x: 28, y: 12 },
  { x: 74, y: 26 },
  { x: 86, y: 8 },
  { x: 80, y: 46 },
];
const p = paintings.sword;
const set = (ext: string) => p.widths.map((w) => `/bg/${p.base}-${w}.${ext} ${w}w`).join(', ');
---
<section class="section hero" id="top" data-hero>
  <Painting name="sword" dim={0.5} />
  <canvas class="stars" data-starfield aria-hidden="true"></canvas>

  <div class="wrap hero-wrap">
    <div class="hero-panel glass strong pad">
      <p class="eyebrow">{site.positioning}</p>
      <h1>
        <span class="first">SONU</span>
        <span class="last">PATIDAR</span>
      </h1>
      <p class="tagline">{site.tagline}</p>
      <p class="intro">{site.intro}</p>
      <div class="ctas">
        <a class="btn btn-red" href="#works">See the works</a>
        <a class="btn btn-ghost" href="/story">Read my story</a>
        <a class="btn btn-ghost" href="/resume">Résumé</a>
      </div>
    </div>

    <figure class="hero-plate">
      <div class="frame" data-constellation>
        <picture>
          <source type="image/avif" srcset={set('avif')} sizes="(max-width: 760px) 92vw, 470px" />
          <source type="image/webp" srcset={set('webp')} sizes="(max-width: 760px) 92vw, 470px" />
          <img src={`/bg/${p.base}-800.webp`} alt={p.alt} width="1125" height="1500" fetchpriority="high" />
        </picture>
        <svg class="lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <polyline data-lines points="" />
        </svg>
        {
          stars.map((s, i) => (
            <button
              type="button"
              class="star"
              style={`left:${s.x}%;top:${s.y}%`}
              data-star={i}
              data-edge={s.x > 70 ? 'right' : s.x < 25 ? 'left' : undefined}
              data-down={s.y < 30 ? '' : undefined}
              aria-pressed="false"
              aria-describedby={`star-tip-${i}`}
            >
              <span class="sr-only">Star {i + 1}: {principles[i].name}</span>
              <span class="tip glass strong" id={`star-tip-${i}`} role="tooltip">
                <strong>{principles[i].name}</strong>
                <span>{principles[i].text}</span>
              </span>
            </button>
          ))
        }
        <p class="sky-done glass strong" data-sky-done hidden role="status">
          All five found. These are the rules I try to work by.
        </p>
        <button
          type="button"
          class="enlarge"
          data-plate-open={`/bg/${p.base}-1125.webp`}
          data-plate-alt={p.alt}
          data-plate-title={p.title}
          aria-label={`View larger: ${p.title}`}
        >
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M8.5 3.5a5 5 0 1 1 0 10 5 5 0 0 1 0-10ZM12.2 12.2 17 17M8.5 6.5v4M6.5 8.5h4" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
        </button>
      </div>
      <figcaption data-sky-hint>
        <span class="num">Plate I</span> Five stars in this sky have names. <em>Find them.</em>
      </figcaption>
    </figure>

    <ul class="metrics glass strong" aria-label="What I work on">
      {
        focus.map((f, i) => (
          <li>
            <span class="num-big"><span class="gl" aria-hidden="true">{['Α', 'Β', 'Γ'][i]}</span> {f.name}</span>
            <span class="label">{f.text}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
  }
  .stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }
  .hero-wrap {
    padding-top: 120px;
    padding-bottom: 56px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 470px);
    gap: 40px 56px;
    align-items: center;
  }
  .hero-panel {
    display: flex;
    flex-direction: column;
    gap: 18px;
    animation: rise 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  h1 {
    display: flex;
    flex-direction: column;
    line-height: 0.92;
  }
  .first {
    font-size: clamp(76px, 9vw, 116px);
    letter-spacing: 0.08em;
  }
  .last {
    font-size: clamp(28px, 3.2vw, 40px);
    letter-spacing: 0.42em;
    color: var(--marble);
    margin-top: 10px;
  }
  .tagline {
    font-size: 26px;
    line-height: 1.4;
    font-style: italic;
  }
  .intro {
    font-size: 20px;
    color: var(--text-2);
    max-width: 34em;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  /* ---------- The plate ---------- */
  .hero-plate {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transform: translate3d(calc(var(--px, 0px) * -0.6), calc(var(--py, 0px) * -0.6), 0);
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .frame {
    position: relative;
    padding: 10px;
    border: 1px solid rgba(237, 229, 220, 0.55);
    border-radius: 6px;
    background: linear-gradient(160deg, rgba(237, 229, 220, 0.24), rgba(237, 229, 220, 0.06));
    box-shadow: 0 40px 90px rgba(2, 8, 34, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }
  .frame img {
    width: 100%;
    height: auto;
    border-radius: 2px;
  }
  .lines {
    position: absolute;
    inset: 10px;
    width: calc(100% - 20px);
    height: calc(100% - 20px);
    overflow: visible;
    pointer-events: none;
  }
  .lines polyline {
    fill: none;
    stroke: rgba(242, 232, 196, 0.85);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 4 6;
  }
  .enlarge {
    position: absolute;
    right: 20px;
    bottom: 20px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.4);
    background: rgba(8, 26, 82, 0.7);
    color: #fff;
    cursor: zoom-in;
  }
  figcaption {
    font-size: 17px;
    color: var(--text-2);
    padding: 0 4px;
  }
  figcaption em {
    color: var(--gold);
  }
  .num {
    font: 13px/1 var(--display);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin-right: 8px;
  }

  /* ---------- Constellation ---------- */
  .star {
    position: absolute;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    border-radius: 50%;
    z-index: 3;
  }
  .star::before,
  .star::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  .star::before {
    width: 7px;
    height: 7px;
    background: #fff;
    box-shadow: 0 0 10px 3px rgba(255, 255, 255, 0.75), 0 0 24px 6px rgba(160, 190, 255, 0.5);
    transition: width 0.3s, height 0.3s, background 0.3s;
  }
  .star::after {
    width: 24px;
    height: 24px;
    border: 1px solid rgba(255, 255, 255, 0.55);
    animation: ping 2.8s ease-out infinite;
  }
  .star:nth-of-type(2)::after {
    animation-delay: 0.6s;
  }
  .star:nth-of-type(3)::after {
    animation-delay: 1.2s;
  }
  .star:nth-of-type(4)::after {
    animation-delay: 1.8s;
  }
  .star:nth-of-type(5)::after {
    animation-delay: 2.4s;
  }
  .star[aria-pressed='true']::before {
    width: 11px;
    height: 11px;
    background: var(--gold);
    box-shadow: 0 0 14px 5px rgba(242, 232, 196, 0.85), 0 0 40px 10px rgba(215, 48, 28, 0.35);
  }
  .star[aria-pressed='true']::after {
    animation: none;
    border-color: rgba(242, 232, 196, 0.6);
    width: 32px;
    height: 32px;
  }
  @keyframes ping {
    0% {
      opacity: 0.8;
      transform: translate(-50%, -50%) scale(0.6);
    }
    80%,
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(1.6);
    }
  }
  .tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 6px);
    transform: translateX(-50%) translateY(6px);
    width: 240px;
    padding: 14px 16px;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: left;
    font: 17px/1.45 var(--body);
    color: var(--text-2);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
    background: rgba(8, 22, 72, 0.9);
  }
  .tip strong {
    font: 19px/1.2 var(--display);
    color: #fff;
  }
  .star:hover .tip,
  .star:focus-visible .tip {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%);
  }
  .star[data-down] .tip {
    bottom: auto;
    top: calc(100% + 6px);
  }
  .star[data-edge='right'] .tip {
    left: auto;
    right: -10px;
    transform: translateY(6px);
  }
  .star[data-edge='left'] .tip {
    left: -10px;
    transform: translateY(6px);
  }
  .star[data-edge]:hover .tip,
  .star[data-edge]:focus-visible .tip {
    transform: none;
  }
  .sky-done {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 20px;
    padding: 14px 18px;
    font-size: 18px;
    animation: rise 0.6s ease-out both;
    background: rgba(8, 22, 72, 0.88);
  }

  /* ---------- Metrics ---------- */
  .metrics {
    grid-column: 1 / -1;
    list-style: none;
    margin: 0;
    padding: 22px 28px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .metrics li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-left: 16px;
    border-left: 1px solid rgba(201, 206, 216, 0.35);
  }
  .metrics li:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .num-big {
    font: 26px/1.2 var(--display);
  }
  .gl {
    color: var(--red-hi);
    margin-right: 6px;
  }
  .label {
    font-size: 17px;
    line-height: 1.35;
    color: #fff;
  }
  .note {
    font-size: 15px;
    line-height: 1.35;
    font-style: italic;
    color: var(--text-3);
  }

  @media (max-width: 1040px) {
    .hero-wrap {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-plate {
      max-width: 520px;
      width: 100%;
      justify-self: center;
    }

  }
  @media (max-width: 760px) {
    .hero-wrap {
      padding-top: 84px;
      gap: 24px;
    }
    .tagline {
      font-size: 22px;
    }
    .metrics {
      grid-template-columns: minmax(0, 1fr);
      padding: 18px 20px;
    }
    .metrics li,
    .metrics li:nth-child(4) {
      border-left: 0;
      padding-left: 0;
    }

    .tip {
      width: 210px;
    }
  }
</style>
