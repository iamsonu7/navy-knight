---
import Painting from './Painting.astro';
import { site, metrics, principles } from '../data/site';

// Named stars, placed in the sky box (percentages). Order = constellation order.
const stars = [
  { x: 14, y: 62 },
  { x: 34, y: 24 },
  { x: 58, y: 44 },
  { x: 76, y: 14 },
  { x: 90, y: 56 },
];
---
<section class="section hero" id="top" data-hero>
  <Painting name="sword" position="50% 22%" tint={0.18} eager depth />
  <canvas class="stars" data-starfield aria-hidden="true"></canvas>
  <picture class="spear" aria-hidden="true">
    <source type="image/avif" srcset="/bg/spear-296.avif" />
    <img src="/bg/spear-296.webp" alt="" width="296" height="860" />
  </picture>

  <div class="wrap hero-wrap">
    <div class="hero-panel glass pad">
      <p class="eyebrow">{site.positioning}</p>
      <h1>
        <span class="first">SONU</span>
        <span class="last">PATIDAR</span>
      </h1>
      <p class="tagline">{site.tagline}</p>
      <p class="intro">{site.intro}</p>
      <div class="ctas">
        <a class="btn btn-red" href="#works">See the works</a>
        <a class="btn btn-ghost" href="#contact">Write to me</a>
      </div>
    </div>

    <div class="sky" data-constellation>
      <svg class="lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <polyline data-lines points="" />
      </svg>
      {
        stars.map((s, i) => (
          <button
            type="button"
            class="star"
            style={`left:${s.x}%;top:${s.y}%`}
            data-star={i}
            data-edge={s.x > 70 ? 'right' : s.x < 25 ? 'left' : undefined}
            data-down={s.y < 35 ? '' : undefined}
            aria-pressed="false"
            aria-describedby={`star-tip-${i}`}
          >
            <span class="sr-only">Star {i + 1}: {principles[i].name}</span>
            <span class="tip glass strong" id={`star-tip-${i}`} role="tooltip">
              <strong>{principles[i].name}</strong>
              <span>{principles[i].text}</span>
            </span>
          </button>
        ))
      }
      <p class="sky-hint" data-sky-hint>
        Five stars in this sky have names. <span>Find them.</span>
      </p>
      <p class="sky-done glass strong" data-sky-done hidden role="status">
        All five found. These are the rules I work by.
        <a href="#craft">See them in practice</a>
      </p>
    </div>

    <ul class="metrics glass" aria-label="In numbers">
      {
        metrics.map((m) => (
          <li>
            <span class="num">
              <span data-count={m.value}>{m.value}</span>{m.suffix}
            </span>
            <span class="label">{m.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
  }
  .stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }
  .spear {
    display: block;
    position: absolute;
    right: 3%;
    bottom: 0;
    height: 80%;
    z-index: 1;
    transform: translate3d(calc(var(--px, 0px) * 2), calc(var(--py, 0px) * 1.4), 0);
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    /* a soft band that follows the shaft, so the photo's own sky melts into the painting */
    -webkit-mask-image: linear-gradient(103deg, transparent 28%, #000 43%, #000 57%, transparent 72%),
      linear-gradient(180deg, transparent, #000 4%, #000 82%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(103deg, transparent 28%, #000 43%, #000 57%, transparent 72%),
      linear-gradient(180deg, transparent, #000 4%, #000 82%, transparent);
    mask-composite: intersect;
    filter: brightness(0.92);
    animation: spear-in 1.6s 0.4s ease-out both;
  }
  .spear img {
    height: 100%;
    width: auto;
  }
  @keyframes spear-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .hero-wrap {
    min-height: 100svh;
    padding-top: 128px;
    padding-bottom: 40px;
    display: grid;
    grid-template-columns: minmax(0, 560px) minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    gap: 40px 48px;
    align-items: center;
  }
  .hero-panel {
    display: flex;
    flex-direction: column;
    gap: 18px;
    animation: rise 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  h1 {
    display: flex;
    flex-direction: column;
    line-height: 0.92;
  }
  .first {
    font-size: clamp(76px, 9vw, 112px);
    letter-spacing: 0.08em;
  }
  .last {
    font-size: clamp(28px, 3.2vw, 40px);
    letter-spacing: 0.42em;
    color: var(--marble);
    margin-top: 10px;
  }
  .tagline {
    font-size: 25px;
    line-height: 1.4;
    font-style: italic;
    color: #fff;
  }
  .intro {
    font-size: 19px;
    color: var(--text-2);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  /* ---------- Constellation ---------- */
  .sky {
    position: relative;
    align-self: stretch;
    min-height: 380px;
  }
  .lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .lines polyline {
    fill: none;
    stroke: rgba(242, 232, 196, 0.75);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 4 6;
  }
  .star {
    position: absolute;
    width: 48px;
    height: 48px;
    margin: -24px 0 0 -24px;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    border-radius: 50%;
    z-index: 3;
  }
  .star::before,
  .star::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  .star::before {
    width: 7px;
    height: 7px;
    background: #fff;
    box-shadow: 0 0 10px 3px rgba(255, 255, 255, 0.7), 0 0 26px 6px rgba(160, 190, 255, 0.45);
    transition: width 0.3s, height 0.3s, background 0.3s;
  }
  .star::after {
    width: 26px;
    height: 26px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    animation: ping 2.8s ease-out infinite;
  }
  .star:nth-of-type(2)::after {
    animation-delay: 0.6s;
  }
  .star:nth-of-type(3)::after {
    animation-delay: 1.2s;
  }
  .star:nth-of-type(4)::after {
    animation-delay: 1.8s;
  }
  .star:nth-of-type(5)::after {
    animation-delay: 2.4s;
  }
  .star[aria-pressed='true']::before {
    width: 11px;
    height: 11px;
    background: var(--gold);
    box-shadow: 0 0 14px 5px rgba(242, 232, 196, 0.8), 0 0 40px 10px rgba(215, 48, 28, 0.35);
  }
  .star[aria-pressed='true']::after {
    animation: none;
    border-color: rgba(242, 232, 196, 0.6);
    width: 34px;
    height: 34px;
  }
  @keyframes ping {
    0% {
      opacity: 0.8;
      transform: translate(-50%, -50%) scale(0.6);
    }
    80%,
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(1.6);
    }
  }
  .tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 6px);
    transform: translateX(-50%) translateY(6px);
    width: 250px;
    padding: 14px 16px;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: left;
    font: 17px/1.45 var(--body);
    color: var(--text-2);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
  }
  .tip strong {
    font: 19px/1.2 var(--display);
    color: #fff;
  }
  .star:hover .tip,
  .star:focus-visible .tip {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%);
  }
  .star[data-edge='right'] .tip {
    left: auto;
    right: -10px;
    transform: translateY(6px);
  }
  .star[data-edge='right']:hover .tip,
  .star[data-edge='right']:focus-visible .tip {
    transform: none;
  }
  .star[data-down] .tip {
    bottom: auto;
    top: calc(100% + 6px);
  }
  .sky-hint {
    position: absolute;
    left: 0;
    bottom: 0;
    font-style: italic;
    font-size: 18px;
    color: var(--text-2);
    text-shadow: 0 1px 12px rgba(3, 10, 40, 0.9);
  }
  .sky-hint span {
    color: var(--gold);
  }
  .sky-done {
    position: absolute;
    right: 0;
    bottom: 0;
    padding: 14px 20px;
    font-size: 18px;
    max-width: 360px;
    animation: rise 0.6s ease-out both;
  }
  .sky-done a {
    display: block;
    margin-top: 4px;
  }

  /* ---------- Metrics ---------- */
  .metrics {
    grid-column: 1 / -1;
    list-style: none;
    margin: 0;
    padding: 18px 28px;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
    background: rgba(10, 26, 80, 0.5);
  }
  .metrics li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-left: 16px;
    border-left: 1px solid rgba(201, 206, 216, 0.35);
  }
  .metrics li:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .num {
    font: 40px/1.1 var(--display);
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  .label {
    font-size: 16px;
    line-height: 1.35;
    color: var(--text-2);
  }

  @media (max-width: 1040px) {
    .spear {
      display: none;
    }
    .hero-wrap {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
    }
    .sky {
      order: -1;
      min-height: 240px;
    }
    .metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .metrics li:nth-child(4) {
      border-left: 0;
      padding-left: 0;
    }
  }
  @media (max-width: 760px) {
    .hero-wrap {
      padding-top: 84px;
      gap: 20px;
    }
    .sky {
      min-height: 200px;
    }
    .tagline {
      font-size: 22px;
    }
    .metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 18px 20px;
    }
    .metrics li,
    .metrics li:nth-child(4) {
      border-left: 0;
      padding-left: 0;
    }
    .num {
      font-size: 32px;
    }
    .tip {
      width: 220px;
    }
    .star[data-edge='left'] .tip {
      left: -10px;
      transform: translateY(6px);
    }
    .star[data-edge='left']:hover .tip,
    .star[data-edge='left']:focus-visible .tip {
      transform: none;
    }
  }
</style>
