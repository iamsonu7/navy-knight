---
import type { Project } from '../data/projects';
import { lensLabels } from '../data/projects';
import ProjectCover from './ProjectCover.astro';
interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props;
---
<article class="card glass" data-card data-lenses={project.lenses.join(' ')}>
  <div class="media">
    <ProjectCover project={project} index={index} />
  </div>
  <div class="body">
    <p class="meta">{project.discipline} · {project.year}</p>
    <h3><a href={`/work/${project.slug}`} data-card-link>{project.title}</a></h3>
    <p class="summary">{project.summary}</p>
    <ul class="lenses" aria-label="Lenses">
      {project.lenses.map((l) => <li>{lensLabels[l]}</li>)}
    </ul>
    <span class="pill view" aria-hidden="true">
      View project
      <svg viewBox="0 0 20 20" width="16" height="16"><path d="M5 10h10M11 6l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>
    </span>
  </div>
</article>

<style>
  .card {
    position: relative;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transform: perspective(900px) rotateX(var(--ry, 0deg)) rotateY(var(--rx, 0deg));
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), background 0.3s, opacity 0.3s;
  }
  /* pointer-following light on the glass */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 0%), rgba(255, 255, 255, 0.16), transparent 60%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .card:hover::before,
  .card:focus-within::before {
    opacity: 1;
  }
  .card:hover :global(.ghost) {
    transform: translate(-10px, 8px) scale(1.06);
  }
  .card:focus-within {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
  }
  .card a:focus-visible {
    outline: none;
  }
  .card[hidden] {
    display: none;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 8px 8px;
    flex: 1;
  }
  .meta {
    font-size: 16px;
    color: var(--text-3);
  }
  h3 {
    font-size: 26px;
    line-height: 1.2;
  }
  h3 a {
    color: #fff;
    text-decoration: none;
  }
  /* whole card is the link target */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  .summary {
    font-size: 18px;
    line-height: 1.55;
    color: var(--text-2);
  }
  .lenses {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .lenses li {
    font-size: 14px;
    letter-spacing: 0.04em;
    padding: 1px 10px;
    border-radius: 999px;
    border: 1px solid rgba(201, 206, 216, 0.45);
    color: var(--text-2);
  }
  .view {
    align-self: flex-start;
    margin-top: auto;
    font-size: 16px;
  }
  .card:hover .view {
    background: var(--marble);
    color: var(--navy);
  }
</style>
