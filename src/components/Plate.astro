---
// A painting shown sharp, framed like a museum plate. Click to see it larger.
import type { Painting } from '../data/paintings';
import { paintings } from '../data/paintings';

interface Props {
  name: Painting;
  numeral?: string;
  sizes?: string;
  eager?: boolean;
  crop?: string; // e.g. '4 / 5' to crop; default shows the whole painting
  position?: string;
  class?: string;
}
const { name, numeral, sizes = '(max-width: 760px) 92vw, 460px', eager = false, crop, position = 'center', class: cls } = Astro.props;
const p = paintings[name];
const set = (ext: string) => p.widths.map((w) => `/bg/${p.base}-${w}.${ext} ${w}w`).join(', ');
const full = p.widths[p.widths.length - 1];
---
<figure class:list={['plate', cls]} data-plate>
  <button type="button" class="frame" data-plate-open={`/bg/${p.base}-${full}.webp`} data-plate-alt={p.alt} data-plate-title={p.title} aria-label={`View larger: ${p.title}`}>
    <picture>
      <source type="image/avif" srcset={set('avif')} sizes={sizes} />
      <source type="image/webp" srcset={set('webp')} sizes={sizes} />
      <img
        src={`/bg/${p.base}-800.webp`}
        alt={p.alt}
        width={full}
        height={Math.round(full * p.ratio)}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding="async"
        style={`${crop ? `aspect-ratio:${crop};` : ''}object-position:${position}`}
      />
    </picture>
    <span class="zoom" aria-hidden="true">
      <svg viewBox="0 0 20 20" width="16" height="16"><path d="M8.5 3.5a5 5 0 1 1 0 10 5 5 0 0 1 0-10ZM12.2 12.2 17 17M8.5 6.5v4M6.5 8.5h4" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
    </span>
    <slot />
  </button>
  <figcaption>
    {numeral && <span class="num">Plate {numeral}</span>}
    <span>{p.title}</span>
  </figcaption>
</figure>

<style>
  .plate {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .frame {
    position: relative;
    display: block;
    width: 100%;
    padding: 10px;
    border: 1px solid rgba(237, 229, 220, 0.55);
    border-radius: 6px;
    background: linear-gradient(160deg, rgba(237, 229, 220, 0.22), rgba(237, 229, 220, 0.06));
    box-shadow: 0 30px 70px rgba(2, 8, 34, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.35);
    cursor: zoom-in;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.4s;
    transform: perspective(1200px) rotateX(var(--ty, 0deg)) rotateY(var(--tx, 0deg));
  }
  .frame:hover {
    box-shadow: 0 40px 90px rgba(2, 8, 34, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }
  .frame img {
    width: 100%;
    height: auto;
    border-radius: 2px;
    object-fit: cover;
  }
  .zoom {
    position: absolute;
    right: 18px;
    bottom: 18px;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(8, 26, 82, 0.7);
    color: #fff;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .frame:hover .zoom,
  .frame:focus-visible .zoom {
    opacity: 1;
  }
  figcaption {
    display: flex;
    gap: 10px;
    align-items: baseline;
    flex-wrap: wrap;
    font-style: italic;
    font-size: 16px;
    color: var(--text-2);
    padding: 0 4px;
  }
  .num {
    font: normal 13px/1 var(--display);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }
</style>
