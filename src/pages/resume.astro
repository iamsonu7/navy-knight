---
import Base from '../layouts/Base.astro';
import Painting from '../components/Painting.astro';
import { resume, type Entry } from '../data/resume';
import { site } from '../data/site';

const linkedin = site.socials.find((s) => s.label === 'LinkedIn');
const sections: { title: string; items: Entry[] }[] = [
  { title: 'Projects', items: resume.projects },
  { title: 'Positions of responsibility', items: resume.positions },
  { title: 'Other experience', items: resume.experience },
];
---
<Base title={`Résumé · ${site.name}`} description={`Résumé of ${site.name}, ${resume.degree}, ${resume.institute}.`}>
  <div class="section page">
    <Painting name="column" dim={0.72} fixed />
    <div class="wrap col">
      <div class="bar">
        <a class="pill" href="/story">Read the personal story instead</a>
        <button type="button" class="btn btn-red" data-print>Download PDF</button>
      </div>

      <article class="sheet" aria-label="Résumé">
        <header class="top">
          <h1>{site.name}</h1>
          <p class="degree">{resume.degree} · {resume.institute}</p>
          <p class="contact">
            <a href={`mailto:${site.email}`}>{site.email}</a>
            {linkedin && (<><span aria-hidden="true">|</span><a href={linkedin.href}>{linkedin.href.replace('https://www.', '').replace(/\/$/, '')}</a></>)}
            <span aria-hidden="true">|</span>
            <span>{resume.location}</span>
          </p>
        </header>

        <section>
          <h2>Education</h2>
          <table class="edu">
            <thead>
              <tr><th scope="col">Programme</th><th scope="col">Institution</th><th scope="col">Year</th></tr>
            </thead>
            <tbody>
              {resume.education.map((e) => (
                <tr><td>{e.course}</td><td>{e.place}</td><td>{e.when}</td></tr>
              ))}
            </tbody>
          </table>
        </section>

        {
          sections.map((sec) => (
            <section>
              <h2>{sec.title}</h2>
              {sec.items.map((x) => (
                <div class="entry">
                  <div class="row">
                    <h3>{x.title}</h3>
                    <span class="when">{x.when}</span>
                  </div>
                  <p class="sub">{x.sub}</p>
                  <ul>
                    {x.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </section>
          ))
        }

        <section>
          <h2>Skills</h2>
          <dl class="kv">
            {resume.skills.map((s) => (<><dt>{s.k}</dt><dd>{s.v}</dd></>))}
          </dl>
        </section>

        <section>
          <h2>Interests</h2>
          <dl class="kv">
            {resume.interests.map((s) => (<><dt>{s.k}</dt><dd>{s.v}</dd></>))}
          </dl>
        </section>
      </article>
    </div>
  </div>
</Base>

<style>
  .col {
    padding-top: 110px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .bar {
    width: 100%;
    max-width: 880px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }
  .bar .pill {
    background: rgba(8, 26, 82, 0.6);
  }

  /* A plain sheet of paper: what a recruiter expects to see */
  .sheet {
    width: 100%;
    max-width: 880px;
    margin-bottom: 56px;
    padding: 56px 64px 64px;
    background: #fdfcf9;
    color: #1a1a1a;
    border-radius: 4px;
    box-shadow: 0 30px 80px rgba(2, 8, 34, 0.6);
    font-family: var(--body);
    font-size: 16.5px;
    line-height: 1.45;
    animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .sheet a {
    color: #1a1a1a;
    text-decoration: none;
  }
  .sheet a:hover {
    text-decoration: underline;
  }
  .sheet :focus-visible {
    outline-color: #22539f;
  }
  .top {
    text-align: center;
    padding-bottom: 14px;
  }
  h1 {
    font-family: var(--display);
    font-size: 36px;
    letter-spacing: 0.06em;
    color: #111;
  }
  .degree {
    margin-top: 4px;
    font-size: 17px;
  }
  .contact {
    margin-top: 4px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 10px;
    font-size: 15.5px;
    color: #333;
  }
  section {
    margin-top: 18px;
  }
  h2 {
    font-family: var(--display);
    font-size: 15px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #0f2a6b;
    padding-bottom: 3px;
    border-bottom: 1.5px solid #0f2a6b;
    margin-bottom: 8px;
  }
  .edu {
    width: 100%;
    border-collapse: collapse;
    font-size: 15.5px;
  }
  .edu th {
    text-align: left;
    font-weight: 500;
    background: #eef0f5;
    padding: 4px 8px;
  }
  .edu td {
    padding: 4px 8px;
    border-bottom: 1px solid #e3e5ea;
  }
  .edu th:last-child,
  .edu td:last-child {
    text-align: right;
    white-space: nowrap;
  }
  .entry + .entry {
    margin-top: 10px;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }
  h3 {
    font-family: var(--body);
    font-weight: 500;
    font-size: 17px;
    line-height: 1.3;
    color: #111;
  }
  .when {
    flex: none;
    font-size: 15px;
    color: #333;
  }
  .sub {
    font-style: italic;
    font-size: 15.5px;
    color: #444;
  }
  ul {
    margin: 3px 0 0;
    padding-left: 20px;
  }
  li {
    margin: 2px 0;
  }
  .kv {
    margin: 0;
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 3px 14px;
  }
  .kv dt {
    font-weight: 500;
  }
  .kv dd {
    margin: 0;
  }

  @media (max-width: 760px) {
    .col {
      padding-top: 84px;
    }
    .sheet {
      padding: 28px 18px 32px;
      font-size: 15.5px;
    }
    h1 {
      font-size: 28px;
    }
    .row {
      flex-direction: column;
      gap: 0;
    }
    .kv {
      grid-template-columns: 1fr;
    }
    .kv dd {
      margin-bottom: 6px;
    }
    .edu {
      font-size: 14px;
    }
    .edu th,
    .edu td {
      padding: 4px 5px;
    }
  }

  @media print {
    @page {
      size: A4;
      margin: 10mm 12mm;
    }
    :global(body) {
      background: #fff !important;
    }
    :global(.nav-shell),
    :global(.skip),
    :global(.wash),
    .bar {
      display: none !important;
    }
    .col {
      padding: 0;
    }
    .sheet {
      max-width: none;
      padding: 0;
      margin: 0;
      box-shadow: none;
      background: #fff;
      animation: none;
      font-size: 9pt;
      line-height: 1.24;
    }
    h1 {
      font-size: 20pt;
    }
    h2 {
      font-size: 9.5pt;
      margin-bottom: 4px;
    }
    h3 {
      font-size: 10pt;
    }
    section {
      margin-top: 7px;
    }
    .kv {
      grid-template-columns: 120px 1fr;
      gap: 1px 10px;
    }
    .page,
    :global(main) {
      min-height: 0 !important;
    }
    .degree,
    .contact,
    .sub,
    .when,
    .edu {
      font-size: 9pt;
    }
    .top {
      padding-bottom: 4px;
    }
    .entry + .entry {
      margin-top: 5px;
    }
    li {
      margin: 0;
    }
    .edu th,
    .edu td {
      padding: 2px 6px;
    }
    .entry {
      break-inside: avoid;
    }
  }
</style>
